            <cameraName>camera</cameraName>
            <depthImageTopicName>depth/image_raw</depthImageTopicName>
            <depthImageCameraInfoTopicName>depth/camera_info</depthImageCameraInfoTopicName>
            <imageTopicName>image_raw</imageTopicName>
            <cameraInfoTopicName>camera_info</cameraInfoTopicName>
            <pointCloudTopicName>points</pointCloudTopicName>
            <frameName>camera_optical</frameName>
            <updateRate>0</updateRate>
            <pointCloudCutoff>0.2</pointCloudCutoff>
          </plugin>
        </sensor>
        <sensor name="front_lidar" type="ray">
          <pose>0 0 0.15 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>false</visualize>
          <ray>
            <scan>
              <horizontal>
                <samples>240</samples>
                <resolution>1</resolution>
                <min_angle>-1.04719755</min_angle>
                <max_angle>1.04719755</max_angle>
              </horizontal>
              <vertical>
                <samples>32</samples>
                <resolution>1</resolution>
                <min_angle>-0.52359878</min_angle>
                <max_angle>0.52359878</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.2</min>
              <max>8.0</max>
              <resolution>0.01</resolution>
            </range>
          </ray>
          <plugin name="lidar_ros" filename="libgazebo_ros_block_laser.so">
            <robotNamespace>/gazebo_fuel</robotNamespace>
            <topicName>lidar/points_raw</topicName>
            <frameName>lidar_link</frameName>
            <gaussianNoise>0.0</gaussianNoise>
            <hokuyoMinIntensity>0.0</hokuyoMinIntensity>
            <updateRate>0</updateRate>
          </plugin>
        </sensor>
